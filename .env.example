# ============================================================
# IdeaScape AI Provider Configuration
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# NVIDIA NIM API (primary provider)
NVIDIA_API_KEY=nvapi-xxx
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# OpenRouter API (legacy — currently unused)
OPENROUTER_API_KEY=sk-or-v1-xxx

# ============================================================
# Collaboration Feature
# ============================================================
# Set to "true" to enable real-time collaboration via Supabase Realtime.
# Requires deployed Edge Functions and linked Supabase project.
VITE_ENABLE_COLLABORATION=true
